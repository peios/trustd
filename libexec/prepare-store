#!/bin/sh
# Give trustd a directory it can own, before trustd starts.
#
# trustd runs as LocalService: it needs no privilege, holds no secret, and
# serves only public data. But it has to write the rendered trust store into
# /system/retc/ssl, and /system/retc is SYSTEM-owned — Everyone gets read
# and execute there, which is right, and means a least-privileged service
# cannot create its own directory.
#
# peinit provisions /run/<service> for a service and nothing else, so this
# runs as ExecStartPre with HookIdentity = SYSTEM: create the directory once
# and hand it to trustd's own service SID. The daemon itself never runs with
# privilege it does not need.
#
# The SID is trustd's service SID -- S-1-5-80 with five little-endian u32
# sub-authorities from SHA-1 of the upper-cased UTF-16LE service name, as
# peinit derives it. Granting the *service* rather than LocalService matters:
# LocalService is shared, and every other service that runs as it has no
# business writing the machine's trust store.
#
# Two things make this less obvious than it looks.
#
# A directory created under /system/retc comes out with **no DACL at all** —
# implicit full access — because nothing on /system/retc is inheritable.
# Adding a single ACE to that is not "granting trustd": it is creating a
# DACL that grants trustd *and nobody else*, which locks out even an
# administrator. So the descriptor is written whole, naming everyone who
# should reach the trust store, not appended to.
#
# It is written once, on the top directory, with CI,OI. Inheritance carries
# it to the two directories below and to every file the renderer writes, so
# the rendered store comes out readable by Everyone — which is the entire
# point of rendering it — without trustd having to stamp anything itself.
#
# `f` is FILE_ALL. Read and write alone are not enough for the daemon:
# creating a file in a directory is governed by FILE_ADD_FILE and
# FILE_ADD_SUBDIRECTORY, which the short forms do not include.
#
# --replace makes it idempotent: on an installed machine these directories
# survive a reboot, and the hook runs again every start.
set -eu

exec > /system/retc/prepare-store.log 2>&1
set -x

TRUSTD_SID='S-1-5-80-158018673-1219163202-1628709498-2735078191-2367099888'
STORE=/system/retc/ssl

mkdir -p "$STORE"
sd allow --replace --flags CI,OI "$STORE" \
  "S-1-5-18:f" \
  "S-1-5-32-544:f" \
  "S-1-1-0:rx" \
  "$TRUSTD_SID:f"
sd show "$STORE"

# Created after the stamp, so both inherit it. The renderer only ever
# empties and exchanges these two; it never creates a directory, and a
# rename carries a descriptor with it.
mkdir -p "$STORE/certs" "$STORE/certs.new"
sd show "$STORE/certs"

echo "prepare-store: $STORE is ready for $TRUSTD_SID"
