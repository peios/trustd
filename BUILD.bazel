load("//packages:package.bzl", "package_store")

package(default_visibility = ["//visibility:public"])

exports_files([
    "Cargo.toml",
    "Cargo.lock",
    "MODULE.bazel",
])

filegroup(
    name = "rust-data",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "//libtrust:Cargo.toml",
        "//libtrust:sources",
        "//trust:Cargo.toml",
        "//trust:sources",
        "//trust-abi:Cargo.toml",
        "//trust-abi:sources",
        "//trust-client:Cargo.toml",
        "//trust-client:sources",
        "//trust-client-core:Cargo.toml",
        "//trust-client-core:sources",
        "//trust-core:Cargo.toml",
        "//trust-core:sources",
        "//trustd:Cargo.toml",
        "//trustd:sources",
    ],
)

filegroup(
    name = "artifacts",
    srcs = [
        "//libtrust:shared",
        "//trust",
        "//trustd:trustd-bin",
    ],
)

filegroup(
    name = "crate-data",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
    ] + ["//trust-core:sources"],
)

filegroup(
    name = "package-data",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
        "LICENSE",
        "//libtrust:headers",
        "//packages:definitions",
        "//packages:family.json",
    ] + [
        "//libtrust:Cargo.toml",
        "//trust:Cargo.toml",
        "//trust-abi:Cargo.toml",
        "//trust-client:Cargo.toml",
        "//trust-client-core:Cargo.toml",
        "//trust-core:Cargo.toml",
        "//trustd:Cargo.toml",
    ] + glob(
        [
            "docs/*.regman",
            "docs/*.evman",
            "docs/man/*",
            "registry.d/*",
            "libexec/*",
            "etc/*",
            "third-party/*",
        ],
        allow_empty = True,
    ),
)

filegroup(
    name = "package-sources",
    srcs = glob(
        [
            "**",
            ".github/**",
            ".bazelrc",
            ".bazelversion",
            ".editorconfig",
            ".gitignore",
            ".gitattributes",
        ],
        allow_empty = True,
        exclude = [
            "**/__pycache__/**",
            "**/*.pyc",
            "**/target/**",
            "target/**",
            "bazel-*/**",
            "**/.git/**",
            ".ci-sdk/**",
            "**/node_modules/**",
            "**/.venv/**",
            "**/.cache/**",
            ".ci-sdk/**",
            "**/node_modules/**",
            "**/.venv/**",
            "**/.cache/**",
            "**/.trail-cache/**",
            "docs/learn/dist/**",
            "docs/archive/**",
            "pekit.toml",
            "lint.pekit.toml",
            "packages.pekit/**",
            "packaging/**",
            "out/**",
            "fuzz/corpus/**",
            "fuzz/artifacts/**",
            ".bazel-vendor/**",
            ".build/**",
            "fuzz/logs/**",
            "fuzz/*.log",
        ],
    ) + [
        "//build:package-files",
        "//libtrust:package-files",
        "//packages:package-files",
        "//trust:package-files",
        "//trust-abi:package-files",
        "//trust-client:package-files",
        "//trust-client-core:package-files",
        "//trust-core:package-files",
        "//trustd:package-files",
        "//vendor/ppk:package-files",
    ],
)

package_store(
    name = "packages",
    packages = ["//packages:all"],
)
