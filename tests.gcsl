# trustd's tests: each member's unit and integration tests, as `cargo test
# -p` builds them, the C client's ABI, each member's documentation tests,
# as `cargo test --doc` runs them, and Clippy's checks, as `cargo clippy
# --all-targets -- -Dwarnings` makes them.
#
# A test's own code runs in a hermetic step of its own, so what it plans,
# builds or fetches is in its parameters' defaults.
import fs
import toolchain
import Toolchain from toolchain
import "github.com/gcslib/rust"
import "github.com/peios/peios-rs" as peios_rs

# The members of the workspace, each a directory of the same name.
let MEMBERS = ["libtrust", "trust-client", "trust-abi", "trust-core", "trust-client-core", "trustd", "trust"]

# Where libtrust is placed, as `build.gcsl` places it for `trust-client`.
let LIBTRUST = "/opt/trust/lib"

# Where the tests find the shared libraries they load.
let LIBRARIES = [{key = "LD_LIBRARY_PATH"; value = "/opt/peios/lib:{LIBTRUST}"}]

# What every test is given: libpeios, by its soname, which a program that
# links it loads (see peios-rs's `runtime`), and libtrust, by its soname,
# which `trust-client` loads.
def loaded() -> List<{at: String, place: Dir | File}> {
    = [...peios_rs.runtime(), {at = "{LIBTRUST}/libtrust.so.1"; place = build libtrust()}]
}

# Runs each of `tests`, given `given`.
fn ran(tests: List<rust.RustTest>, given: List<{at: String, place: Dir | File}>) -> {} {
    let each = for test in tests { = rust.run_test(test, given = given, env = LIBRARIES) }
}

def test libtrust(tests: List<rust.RustTest> = rust.tests(crates(), "libtrust"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

def test trust_client(tests: List<rust.RustTest> = rust.tests(crates(), "trust-client"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

def test trust_abi(tests: List<rust.RustTest> = rust.tests(crates(), "trust-abi"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

def test trust_core(tests: List<rust.RustTest> = rust.tests(crates(), "trust-core"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

def test trust_client_core(
    tests: List<rust.RustTest> = rust.tests(crates(), "trust-client-core"),
    given: List<{at: String, place: Dir | File}> = loaded(),
) {
    = ran(tests, given)
}

# trustd's library and program tests.
def test trustd(tests: List<rust.RustTest> = rust.tests(crates(), "trustd"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

def test trust(tests: List<rust.RustTest> = rust.tests(crates(), "trust"), given: List<{at: String, place: Dir | File}> = loaded()) {
    = ran(tests, given)
}

# Each member's documentation tests.
def test doctests(
    ran: List<List<{}>> = for each in MEMBERS { = rust.doctests(crates(), each, given = loaded(), env = LIBRARIES) },
) {}

# Clippy's checks of each member, every warning denied.
def test clippy(checked: List<List<{}>> = for each in MEMBERS { = rust.clippy(crates(), each, flags = ["-Dwarnings"]) }) {}

# The C client's ABI: a C program that includes its public header and links
# it calls it, run against libtrust by its soname.
def test abi(
    library: File = build libtrust(),
    libpeios: List<{at: String, place: Dir | File}> = peios_rs.runtime(),
    include: Dir = dir("libtrust/include"),
    source: File = file("libtrust/tests/abi.c"),
    c: toolchain.CToolchain = toolchain.get(Toolchain::C),
) {
    let home = working_dir().path
    let made = fs.mkdir("{home}/out")
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = c.runtime},
        {at = "/opt/cc"; place = c.root},
        {at = "/work/out"; place = dir("{home}/out")},
        {at = "/work/include"; place = include},
        {at = "/work/abi.c"; place = source},
        {at = "{LIBTRUST}/libtrust.so"; place = library},
        {at = "{LIBTRUST}/libtrust.so.1"; place = library},
        ...(for each in libpeios { = {at = each.at; place = each.place} }),
    ]
    let box = fs.compose(placed).sandbox(cwd = "/work", env = {LD_LIBRARY_PATH = "/opt/peios/lib:{LIBTRUST}"})
    let cc = c.cc.path.strip_prefix(c.root.path)
    let compiled = box.exec(
        "/opt/cc{cc}",
        "-UNDEBUG",
        "-I/work/include",
        "/work/abi.c",
        "-o",
        "/work/out/abi",
        "-L{LIBTRUST}",
        "-Wl,-rpath-link,/opt/peios/lib",
        "-ltrust",
    )
    let ran = box.exec("/work/out/abi")
}
