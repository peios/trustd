{
    "side_effects": ["man-db"],
    "package": {
        "name": "dev.peios.trustd",
        "description": "Peios machine trust-store composition and query service",
        "version": "0.1.6-1",
        "architecture": "x86_64",
        "license_class": "free",
        "homepage": "https://github.com/peios/trustd"
    },
    "dependencies": {
        "dev.peios.libpeios": ">= 0.5.12-1",
        "org.gnu.glibc": "*",
        "org.gnu.gcc-libgcc": "*",
        "dev.peios.peiosutils": "*",
        "org.mozilla.ca-certificates": "*",
        "sh": "*"
    },
    "files": {
        "source:LICENSE": "usr/share/licenses/dev.peios.trustd/LICENSE",
        "stage:licenses/trustd/**": "usr/share/licenses/dev.peios.trustd/third-party",
        "stage:usr/sbin/trustd": "usr/sbin/trustd",
        "stage:usr/libexec/trustd/prepare-store": "usr/libexec/trustd/prepare-store",
        "stage:usr/share/regim/trustd-service.reg": "usr/share/regim/trustd-service.reg",
        "stage:usr/share/regman/trustd.regman": "usr/share/regman/trustd.regman",
        "source:docs/trustd.evman": "usr/share/evman/trustd.evman",
        "stage:usr/share/man/man8/trustd.8.gz": "usr/share/man/man8/trustd.8.gz"
    },
    "license_component": "trustd",
    "executables": ["usr/sbin/trustd", "usr/libexec/trustd/prepare-store"]
}
